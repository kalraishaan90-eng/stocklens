# StockLens Backend Environment Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Google Gemini API Key (Optional: Falls back to deterministic financial explainer if blank)
GEMINI_API_KEY=

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECONDS=3600
PRICE_CACHE_TTL_SECONDS=21600

# Per-client /api/analyze limit (sliding 60-second window)
ANALYZE_RATE_LIMIT_PER_MINUTE=60

# Analytics settings
RISK_FREE_RATE_PCT=6.5
BENCHMARK_TICKER=^NSEI
VERIFY_TICKERS_ON_STARTUP=true

# Offline Demo Mode fallback enabled
OFFLINE_DEMO_ENABLED=true
